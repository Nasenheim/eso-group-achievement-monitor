<GuiXml
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://sir.insidi.at/or/schema/esoui.xsd"
>
    <Controls>
        <TopLevelControl
            name="GroupAchievementMonitorWindow"
            tier="MEDIUM"
            layer="CONTROLS"
            mouseEnabled="true"
            movable="true"
            clampedToScreen="true"
            hidden="true"
        >
            <Dimensions x="500" y="800" />
            <Anchor point="CENTER" relativeTo="GuiRoot" relativePoint="CENTER" />

            <Controls>
                <Backdrop name="$(parent)BG" inherits="ZO_DefaultBackdrop" alpha="0.75" />

                <Control name="$(parent)Header">
                    <Dimensions x="480" y="50" />
                    <Anchor point="TOP" relativeTo="$(parent)" relativePoint="TOP" />
                    <Controls>
                        <Label
                            name="$(parent)Title"
                            font="ZoFontHeader2"
                            text="Group Achievement Monitor"
                        >
                            <Anchor point="CENTER" relativeTo="$(parent)" relativePoint="CENTER" />
                        </Label>
                        <Button name="$(parent)Hide" inherits="ZO_ButtonBehaviorClickSound">
                            <Dimensions x="24" y="24" />
                            <Anchor point="RIGHT" relativeTo="$(parent)" relativePoint="RIGHT" />
                            <Textures
                                normal="/esoui/art/buttons/decline_up.dds"
                                pressed="/esoui/art/buttons/decline_down.dds"
                                mouseOver="/esoui/art/buttons/decline_over.dds"
                                disabled="/esoui/art/buttons/decline_disabled.dds"
                            />
                        </Button>
                    </Controls>
                </Control>

                <Texture
                    name="$(parent)HeaderDivider"
                    textureFile="/esoui/art/miscellaneous/centerscreen_topdivider.dds"
                >
                    <Dimensions x="500" y="2" />
                    <Anchor point="TOP" relativeTo="$(parent)Header" relativePoint="BOTTOM" />
                </Texture>

                <Control name="$(parent)Options">
                    <Dimensions x="460" y="170" />
                    <Anchor point="TOP" relativeTo="$(parent)HeaderDivider" relativePoint="BOTTOM"
                        offsetY="10" />
                    <Controls>
                        <!-- <Backdrop name="$(parent)BG" inherits="ZO_DefaultBackdrop" alpha="0.25"
                        /> -->
                    </Controls>
                </Control>

                <Texture
                    name="$(parent)OptionsDivider"
                    textureFile="/esoui/art/miscellaneous/horizontaldivider.dds">
                    <Dimensions x="500" y="2" />
                    <Anchor point="TOP" relativeTo="$(parent)Options" relativePoint="BOTTOM"
                        offsetY="10" />
                </Texture>

                <Control name="$(parent)PlayerList">
                    <Dimensions x="460" y="0" />
                    <Anchor point="TOP" relativeTo="$(parent)OptionsDivider" relativePoint="BOTTOM"
                        offsetY="10" />
                    <Anchor point="BOTTOM" relativeTo="$(parent)" relativePoint="BOTTOM"
                        offsetY="-10" />
                    <Controls>
                        <!-- <Backdrop name="$(parent)BG" inherits="ZO_DefaultBackdrop" alpha="0.25"
                        /> -->
                    </Controls>
                </Control>
            </Controls>
        </TopLevelControl>

        <Control name="GroupAchievementMonitorPlayerListEntryTemplate" virtual="true"
            mouseEnabled="true">
            <Dimensions x="460" y="40" />
            <Anchor point="TOP" relativeTo="$(parent)" relativePoint="TOP" />
            <Controls>
                <Backdrop
                    name="$(parent)BG"
                    inherits="ZO_DefaultBackdrop"
                    alpha="0.5"
                    hidden="true"
                />

                <Control name="$(parent)Display">
                    <Dimensions x="400" y="40" />
                    <Anchor point="LEFT" relativeTo="$(parent)" relativePoint="LEFT" />
                    <Controls>
                        <!-- <Backdrop name="$(parent)BG" inherits="ZO_DefaultBackdrop" alpha="0.25"
                        /> -->
                        <Texture
                            name="$(parent)ChampionIcon"
                            textureFile="/esoui/art/champion/gamepad/gp_champion_icon.dds"
                        >
                            <Dimensions x="20" y="20" />
                            <Anchor
                                point="TOPLEFT"
                                relativeTo="$(parent)"
                                relativePoint="TOPLEFT"
                                offsetY="1"
                            />
                        </Texture>
                        <Label name="$(parent)PlayerLevel" font="ZoFontGame">
                            <Dimensions x="40" y="20" />
                            <Anchor
                                point="LEFT"
                                relativeTo="$(parent)ChampionIcon"
                                relativePoint="RIGHT"
                                offsetY="-1"
                            />
                        </Label>
                        <Label name="$(parent)PlayerName" font="ZoFontGame" wrapMode="ELLIPSIS">
                            <Dimensions x="330" y="20" />
                            <Anchor
                                point="LEFT"
                                relativeTo="$(parent)PlayerLevel"
                                relativePoint="RIGHT"
                            />
                        </Label>

                        <Label name="$(parent)IndentedArrow" font="ZoFontGame" text="→">
                            <Dimensions x="20" y="20" />
                            <Anchor
                                point="BOTTOMLEFT"
                                relativeTo="$(parent)"
                                relativePoint="BOTTOMLEFT"
                                offsetX="10"
                            />
                        </Label>
                        <Label
                            name="$(parent)Achievement"
                            font="ZoFontGame"
                            wrapMode="ELLIPSIS"
                            linkEnabled="true"
                            mouseEnabled="true"
                        >
                            <Dimensions x="230" y="20" />
                            <Anchor
                                point="LEFT"
                                relativeTo="$(parent)IndentedArrow"
                                relativePoint="RIGHT"
                            />
                        </Label>
                        <Label
                            name="$(parent)AchievementDate"
                            font="ZoFontGame"
                            horizontalAlignment="RIGHT"
                        >
                            <Dimensions x="120" y="20" />
                            <Anchor
                                point="TOPRIGHT"
                                relativeTo="$(parent)PlayerName"
                                relativePoint="BOTTOMRIGHT"
                            />
                        </Label>
                    </Controls>
                </Control>

                <Control name="$(parent)Edit">
                    <Dimensions x="60" y="40" />
                    <Anchor point="LEFT" relativeTo="$(parent)Display" relativePoint="RIGHT" />
                    <Controls>
                        <!-- <Backdrop name="$(parent)BG" inherits="ZO_DefaultBackdrop" alpha="0.25"
                        /> -->

                        <Button
                            name="$(parent)AcceptManually"
                            inherits="ZO_ButtonBehaviorClickSound"
                        >
                            <Dimensions x="24" y="24" />
                            <Anchor point="LEFT" relativeTo="$(parent)" relativePoint="LEFT" />
                            <Textures
                                normal="/esoui/art/buttons/accept_up.dds"
                                pressed="/esoui/art/buttons/accept_down.dds"
                                mouseOver="/esoui/art/buttons/accept_over.dds"
                                disabled="/esoui/art/buttons/accept_disabled.dds"
                            />
                        </Button>

                        <Button
                            name="$(parent)RejectManually"
                            inherits="ZO_ButtonBehaviorClickSound"
                        >
                            <Dimensions x="24" y="24" />
                            <Anchor
                                point="LEFT"
                                relativeTo="$(parent)AcceptManually"
                                relativePoint="RIGHT"
                                offsetX="10"
                            />
                            <Textures
                                normal="/esoui/art/buttons/decline_up.dds"
                                pressed="/esoui/art/buttons/decline_down.dds"
                                mouseOver="/esoui/art/buttons/decline_over.dds"
                                disabled="/esoui/art/buttons/decline_disabled.dds"
                            />
                        </Button>
                    </Controls>
                </Control>
            </Controls>
        </Control>
    </Controls>
</GuiXml>